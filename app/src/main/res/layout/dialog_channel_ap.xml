<?xml version="1.0" encoding="utf-8"?>
<!--
  AP 详情弹窗。

  视觉层次：顶部一块强调底色承载「信号强度」（数值最大最粗 + 分段信号条），
  下面按 网络 / 射频 / 接入点 三组排列，每组有一个小号大写的分组标题，
  行内左侧是灰色标签、右侧是高对比度的值。
  颜色一律走 detail_* 资源，日间/夜间各有一套，避免暗主题下对比度不足。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/detail_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <!-- ============ 信号强度：整块强调区 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/detail_surface_alt"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetailRssi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/detail_title"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailRssiUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/channel_detail_dbm"
                    android:textColor="@color/detail_label"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvDetailLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/detail_title"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 分段信号条：底槽 + 填充（宽度与颜色由代码设置） -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/signal_bar_track">

                <View
                    android:id="@+id/vSignalFill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/signal_bar_fill" />
            </FrameLayout>
        </LinearLayout>

        <!-- ============ 网络 ============ -->
        <TextView
            style="@style/DetailSectionHeader"
            android:text="@string/channel_detail_section_network" />

        <LinearLayout
            style="@style/DetailRow">

            <TextView
                style="@style/DetailLabel"
                android:text="@string/channel_detail_label_ssid" />

            <TextView
                android:id="@+id/tvDetailSsid"
                style="@style/DetailValue" />
        </LinearLayout>

        <LinearLayout
            style="@style/DetailRow">

            <TextView
                style="@style/DetailLabel"
                android:text="@string/channel_detail_label_capabilities" />

            <TextView
                android:id="@+id/tvDetailCapabilities"
                style="@style/DetailValue"
                android:fontFamily="monospace"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ============ 射频 ============ -->
        <TextView
            style="@style/DetailSectionHeader"
            android:text="@string/channel_detail_section_rf" />

        <LinearLayout
            style="@style/DetailRow">

            <TextView
                style="@style/DetailLabel"
                android:text="@string/channel_detail_label_freq" />

            <TextView
                android:id="@+id/tvDetailFreq"
                style="@style/DetailValue" />
        </LinearLayout>

        <LinearLayout
            style="@style/DetailRow">

            <TextView
                style="@style/DetailLabel"
                android:text="@string/channel_detail_label_range" />

            <TextView
                android:id="@+id/tvDetailRange"
                style="@style/DetailValue" />
        </LinearLayout>

        <LinearLayout
            style="@style/DetailRow">

            <TextView
                style="@style/DetailLabel"
                android:text="@string/channel_detail_label_band" />

            <TextView
                android:id="@+id/tvDetailBand"
                style="@style/DetailValue" />
        </LinearLayout>

        <!-- 带宽 / 标准 / 加密 三个短值并排成胶囊 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDetailBandwidthChip"
                style="@style/DetailChip" />

            <TextView
                android:id="@+id/tvDetailStandardChip"
                style="@style/DetailChip"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/tvDetailSecurityChip"
                style="@style/DetailChip"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- ============ 接入点 ============ -->
        <TextView
            style="@style/DetailSectionHeader"
            android:text="@string/channel_detail_section_ap" />

        <LinearLayout
            style="@style/DetailRow">

            <TextView
                style="@style/DetailLabel"
                android:text="@string/channel_detail_label_mac" />

            <TextView
                android:id="@+id/tvDetailMac"
                style="@style/DetailValue"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            style="@style/DetailRow">

            <TextView
                style="@style/DetailLabel"
                android:text="@string/channel_detail_label_vendor" />

            <TextView
                android:id="@+id/tvDetailVendor"
                style="@style/DetailValue" />
        </LinearLayout>

        <LinearLayout
            style="@style/DetailRow">

            <TextView
                style="@style/DetailLabel"
                android:text="@string/channel_detail_label_ap_name" />

            <TextView
                android:id="@+id/tvDetailApName"
                style="@style/DetailValue"
                android:textColor="@color/detail_accent"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowDetailBuilding"
            style="@style/DetailRow"
            android:visibility="gone">

            <TextView
                style="@style/DetailLabel"
                android:text="@string/channel_detail_label_building" />

            <TextView
                android:id="@+id/tvDetailBuilding"
                style="@style/DetailValue" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDetailStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/detail_label"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
